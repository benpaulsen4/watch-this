# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/watchthis"

# TMDB API Configuration
TMDB_API_KEY="your_tmdb_api_key_here"

# Site URL
# Used for canonical URLs, OpenGraph tags, sitemap and robots.txt. Either works;
# NEXT_PUBLIC_SITE_URL takes precedence and is the one available to client
# components. On Vercel, VERCEL_URL is injected automatically and is used as a
# fallback, so neither is required there.
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WebAuthn Configuration
# WEBAUTHN_RP_ID and WEBAUTHN_ORIGIN default to localhost only outside
# production. In production the app refuses to start a ceremony without them,
# rather than silently validating against localhost.
WEBAUTHN_RP_NAME="WatchThis"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"
WEBAUTHN_SECRET="your_webauthn_secret_here"

# Admin API
# Shared secret required by POST /api/admin/device-claim, which mints a passkey
# claim for a user who has locked themselves out. Leave unset to disable the
# endpoint entirely.
ADMIN_API_SECRET="your_admin_api_secret_here"
